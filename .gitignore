# ── 敏感配置 ───────────────────────────────────────────────────
# API Keys，绝对不提交
.env

# ── 私有数据（本地知识库内容）──────────────────────────────────
# 英文/多语言文档目录
docs/
# 中文文档目录
docs_zh/
# ChromaDB 向量索引（自动生成）
chroma_db/

# 对话历史数据库目录（自动生成）
sqlite_db/
history/

# ── Python 运行时 ──────────────────────────────────────────────
__pycache__/
# .pyc / .pyo / .pyd
*.py[cod]                   
*.pyo

# ── 虚拟环境 ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── 测试 & 覆盖率 ──────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Jupyter Notebook ───────────────────────────────────────────
.ipynb_checkpoints/

# ── 构建产物 ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── 类型检查 ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── 编辑器 ─────────────────────────────────────────────────────
# 个人 VSCode 设置（保留 extensions.json 等团队配置）
.vscode/settings.json
.idea/
*.swp
*.swo

# ── 操作系统 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.code-workspace

