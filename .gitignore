# ==============================================================
# AgentA —— 私有知识库 Agent
# ==============================================================

# ── 敏感配置 ───────────────────────────────────────────────────
# API Keys，绝对不提交
.env

# ── 私有数据（本地知识库内容）──────────────────────────────────
# 数据集根目录：英文/多语在 datasets/data_en，中文在 datasets/data_zh
# 白名单用于 tests/rag/test_rag_parser.py 的 fixture（CI 必需），也是新用户克隆仓库后的 demo 样本。
datasets/*
!datasets/data_en/
datasets/data_en/*
!datasets/data_en/test/
datasets/data_en/test/*
!datasets/data_en/test/test_sample.*

# 本地运行期数据（向量库 / SQLite / BM25；默认见 src/config.py，可经 .env 改路径）
db/
# 旧版默认路径（仍 .gitignore，便于本地未迁移的仓库）
chroma_db/
# BM25 倒排索引（旧默认可能在仓库根 bm25_index/；新默认在 db/bm25/）
bm25_index/

# 评估报告 / 自定义黄金集（自动生成 / 个人数据）
reports/
tools/rag_eval/golden.json

# 对话历史目录
history/

# 运行时数据备份（含明文密钥的 zip，绝不进 git）
backups/

# 日志文件目录
logs/

# UI dev server 后台 PID + .cmd 包装器（tools/dev_server.ps1 自动生成）
.run/

# ── Skills/MCP disabled 列表 ───────────────────────────────────
.agenta/skills/disabled.json
.agenta/mcp/disabled.json

# ── 配置 UI runtime override（个人本地修改，不进 git）──────────
.agenta/config_overrides.json
.agenta/routing_pool.json

# ── API key（admin 在 UI 配的明文密钥，绝不进 git）─────────────
.agenta/api_keys.json

# ── Python 运行时 ──────────────────────────────────────────────
__pycache__/
# .pyc / .pyo / .pyd
*.py[cod]                   
*.pyo

# ── 虚拟环境 ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── 测试 & 覆盖率 ──────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Jupyter Notebook ───────────────────────────────────────────
.ipynb_checkpoints/

# ── 构建产物 ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── 类型检查 ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── 编辑器 ─────────────────────────────────────────────────────
# 个人 VSCode 设置（保留 extensions.json 等团队配置）
.vscode/settings.json
.idea/
*.swp
*.swo

# ── 前端项目（frontend/）─────────────────────────────────────
# frontend/.gitignore 已覆盖；此处作为兜底，防止顶级误提交
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── 操作系统 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.code-workspace
*.exe

# ── Codegraph ───────────────────────────────────────────────────
.codegraph/
