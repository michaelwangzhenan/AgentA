########################################
# HuggingFace 镜像（解决国内访问 huggingface.co 被墙问题）
########################################
HF_ENDPOINT=https://hf-mirror.com
# 第一次运行时设置为0， 模型缓存到本地后设为 1，禁止联网检查，加快启动速度
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# 消除 tokenizer FutureWarning
TOKENIZERS_PARALLELISM=false


########################################
# LLM HTTP 代理（仅对国外服务生效：openai / grok / claude；国内直连不需要）
########################################
LLM_PROXY=http://IP：PORT


########################################
# LLM Provider 选择
########################################
# 国内直连：kimi / qwen / glm / deepseek / minimax / ollama
# 国外需代理：openai / grok / claude
LLM_PROVIDER=qwen


########################################
# LLM API Keys
########################################
# OpenAI
OPENAI_API_KEY=sk-<YOUR_OPENAI_API_KEY>

# Anthropic
ANTHROPIC_API_KEY=sk-<YOUR_ANTHROPIC_API_KEY>

# Grok/xAI
# Grok API Key 1
GROK_API_KEY1=xai-<YOUR_GROK_API_KEY1>
# Grok API Key 2
GROK_API_KEY2=xai-<YOUR_GROK_API_KEY2>

# Kimi
MOONSHOT_API_KEY=sk-<YOUR_MOONSHOT_API_KEY>

# DeepSeek
DEEPSEEK_API_KEY=sk-<YOUR_DEEPSEEK_API_KEY>

# Qwen
QWEN_API_KEY=sk-<YOUR_QWEN_API_KEY>

# MiniMax
MINIMAX_API_KEY=sk-<YOUR_MINIMAX_API_KEY>

# GLM
GLM_API_KEY=sk-<YOUR_GLM_API_KEY>


########################################
# 工具/搜索 API Keys
########################################
# SerpAPI（Google/Bing 搜索接口）
SERPAPI_API_KEY=sk-<YOUR_SERPAPI_API_KEY>

########################################
# LangChain 配置
########################################
# LangChain API Key（用于 LangSmith 追踪与管理）
LANGCHAIN_API_KEY=lsv2_pt_<YOUR_LANGCHAIN_API_KEY>
# LangChain 追踪功能开关
LANGCHAIN_TRACING_V2=true
# LangChain 服务端点
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LangChain 项目名称（可选）
LANGCHAIN_PROJECT=<YOUR_LANGCHAIN_PROJECT>  # 如果没有指定，则使用默认设置


########################################
# Embedding 模型配置
########################################
# 别名 en → all-MiniLM-L6-v2（英文/多语言，默认）
# 别名 zh → BAAI/bge-small-zh（中文优化）
EMBEDDING_MODEL=en

########################################
# RAG / ChromaDB 配置（一般无需修改）
########################################
CHROMA_DB_PATH=./chroma_db
DOCS_DIR=./docs
RAG_TOP_K=5

########################################
# Reranker 配置（Cross-Encoder 二阶段精排）
########################################
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_RECALL_MULTIPLIER=3

########################################
# 对话历史存储路径
########################################
MEMORY_DB_PATH=./sqlite_db/chat_history.db

########################################
# Extended Thinking 配置
########################################
# 是否启用 Extended Thinking
THINKING_ENABLED=false

# Adaptive Thinking：自动根据问题复杂度估算 budget（LOW 1500 / MEDIUM 8000 / HIGH 32000）
# 仅在 THINKING_ENABLED=true 时生效
THINKING_ADAPTIVE=false

# Extended Thinking 预算，单位 tokens（默认 8000）
# 当 THINKING_ADAPTIVE=true 时，本值作为自动估算的上限（cap）
THINKING_BUDGET=8000

########################################
# 跨 session 用户记忆配置
########################################
# 是否启用跨 session 记忆功能（默认关闭，开启后每轮对话可持久化用户信息）
USER_MEMORY_ENABLED=true
# 用户记忆数据库路径（独立于对话历史 DB）
USER_MEMORY_DB_PATH=./sqlite_db/user_memory.db
# 注入 system prompt 的记忆最大字符数（超出部分截断）
USER_MEMORY_MAX_CHARS=1500
# 每轮对话结束后自动调用 LLM 提取记忆（每轮额外消耗 tokens，默认关闭）
# 关闭时仍可通过说 "记住这个" / "remember this" 触发即时提取
USER_MEMORY_AUTO_EXTRACT=false
########################################
# Agent 实现方式选择
########################################
# PYTHON   - 手写 ReAct 循环（默认，稳定，支持 Extended Thinking）
# LANGCHAIN - LangChain create_agent 驱动（实验性）
# AUTOGPT   - 暂未实现，配置后会打印提示并退出
IMP_METHOD=PYTHON
