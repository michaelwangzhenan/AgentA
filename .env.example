########################################
# HuggingFace 配置
########################################
# 国内镜像，解决 huggingface.co 访问受限问题
HF_ENDPOINT=https://hf-mirror.com
# 模型下载缓存到本地后设为 1，禁止联网检查，加快启动速度
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# 消除 tokenizer FutureWarning
TOKENIZERS_PARALLELISM=false

########################################
# LLM Provider 选择
########################################
# 当前激活的 LLM Provider（可选值：kimi / openai / deepseek / grok / ollama / claude）
LLM_PROVIDER=kimi

########################################
# LLM API Keys（只需填写当前使用的 Provider）
########################################
# Moonshot Kimi（推荐开发/测试，免费额度大）
MOONSHOT_API_KEY=sk-...

# OpenAI GPT 系列
OPENAI_API_KEY=sk-...
# HTTP 代理（对国外服务生效：openai / grok / claude；国内直连不需要）
LLM_PROXY=http://代理IP:端口

# DeepSeek（高性价比国产模型）
DEEPSEEK_API_KEY=sk-...

# 阿里云通义千问 Qwen
QWEN_API_KEY=sk-...

# MiniMax
MINIMAX_API_KEY=sk-...

# 智谱 AI GLM
GLM_API_KEY=<key>.<secret>

# xAI Grok
GROK_API_KEY1=xai-...

# Anthropic Claude（需额外安装：pip install anthropic）
ANTHROPIC_API_KEY=sk-ant-...

########################################
# Embedding 模型配置
########################################
# 别名 en → all-MiniLM-L6-v2（英文/多语言，默认）
# 别名 zh → BAAI/bge-small-zh（中文优化）
EMBEDDING_MODEL=en

########################################
# RAG / ChromaDB 配置（一般无需修改）
########################################
CHROMA_DB_PATH=./chroma_db
DOCS_DIR=./docs
RAG_TOP_K=5

########################################
# Reranker 配置（Cross-Encoder 二阶段精排）
########################################
# true 开启精排（推荐）；false 关闭则只使用 Bi-Encoder round-robin 结果
RERANKER_ENABLED=true
# 精排模型，默认 cross-encoder/ms-marco-MiniLM-L-6-v2（约23MB，中英文双语）
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 召回窗口倍数：精排前取 RAG_TOP_K × N 条候选，默认 3
RERANKER_RECALL_MULTIPLIER=3

# 对话历史 SQLite 文件路径（默认 ../sqlite_db/chat_history.db）
MEMORY_DB_PATH=../sqlite_db/chat_history.db
