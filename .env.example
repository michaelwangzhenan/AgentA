########################################
# 1.前置依赖：HuggingFace 镜像 / 离线开关 / Tokenizer
########################################
# HuggingFace 镜像端点。
# 国内镜像：https://hf-mirror.com 
# 直连环境：https://huggingface.co 或留空（库内默认值）
HF_ENDPOINT=https://hf-mirror.com

# Transformers / Datasets 离线模式（可选值：0 / 1）
# 0 = 每次启动联网检查模型更新（首次下载或换模型时用）
# 1 = 离线模式，不进行联网检查（模型已缓存后用，可显著加快启动）
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# 是否启用 HuggingFace tokenizer 多线程并行（可选值：true / false）
# false = 关闭并行，可消除 fork 后的 FutureWarning（对吞吐无明显影响，推荐保持 false）
TOKENIZERS_PARALLELISM=false


########################################
# 2.0.Ingestion · 公共（路径 / 分块）
########################################
# 待入库的源文档目录（tools/rag_cli.py ingest 默认扫描的目录）
# 工程默认按语种分库：英文/多语 → ./datasets/data_en；中文 → ./datasets/data_zh
DOCS_DIR=./datasets/data_en

# Web UI 拖拽上传的落盘目录（独立于 DOCS_DIR；POST /api/kb/upload 用）
WEB_UPLOAD_DIR=./datasets/web_uploads

# Web UI 单次上传文件大小上限（MB），超限返回 413
WEB_MAX_UPLOAD_MB=10

# 单文件 ingest 超时（秒）；超时返回 504，避免 deadlock / 大文件 parse 拖死后端
WEB_INGEST_TIMEOUT_SEC=60

# ChromaDB 向量库存储目录（BM25 索引留空时也落在此目录旁）
CHROMA_DB_PATH=./chroma_db

# —— 文本分块超参（一般无需调整）——
# 单个 chunk 的最大字符数
CHUNK_SIZE=600
# 相邻 chunk 的重叠字符数（防止跨边界语义被切断）
CHUNK_OVERLAP=100


########################################
# 2.1.Ingestion · PDF OCR 兜底（扫描版 / 图片版 PDF）
########################################
# 当 PDF 文本层提取的"平均每页字符数"低于阈值时，自动调 rapidocr-onnxruntime OCR
# 可选值：true / false；rapidocr-onnxruntime 与 pymupdf 未安装时本功能静默禁用
RAG_OCR_FALLBACK_ENABLED=true

# 每页字符数低于此值触发 OCR（纯文本 PDF 通常每页数百字，扫描版 < 30）
RAG_OCR_TRIGGER_CHARS_PER_PAGE=50

# OCR 渲染 DPI；越大越清晰但越慢，200 是质量/速度平衡点
RAG_OCR_DPI=200


########################################
# 2.1.1.Embedding（Dense 索引）
########################################
# 默认使用的 Embedding 别名（影响 ingest 时入哪个库；可选值：en / zh / m3，或直接填模型全名）
#   en → all-MiniLM-L6-v2   英文/多语言，384 维（轻量）
#   zh → BAAI/bge-small-zh  中文优化，512 维
#   m3 → BAAI/bge-m3        多语言，1024 维（推荐，单模型覆盖中英）
EMBEDDING_MODEL=m3

# 检索（retriever）时查询的 collection 列表（控制 retriever 遍历哪些库，逗号分隔）
# 常用组合：
#   en,zh   双语种双库（中英文资料分别用 en/zh 模型 ingest）
#   m3      bge-m3 单库（需先用 EMBEDDING_MODEL=m3 ingest 一次）
#   en      仅英文库（消融实验）
RAG_ACTIVE_EMBEDDINGS=m3


########################################
# 2.1.2.BM25（Sparse 索引）
########################################
# 是否启用 BM25（可选值：true / false）；开启后与 dense 并行召回，再用 RRF 融合
# 对专有名词/缩写/版本号等"低 embedding 区分度"的查询命中显著优于纯 dense
BM25_ENABLED=true

# Okapi BM25 经典超参（一般无需调整）：
#   k1 = term frequency 饱和度，常用 1.2~2.0
#   b  = 文档长度归一化强度，0~1
BM25_K1=1.5
BM25_B=0.75

# BM25 索引存储目录；留空则与 CHROMA_DB_PATH 同级
BM25_INDEX_DIR=


########################################
# 2.2.Query rewrite（Multi-Query / HyDE / 翻译轴）
########################################
# Multi-Query：让 LLM 生成 N 条同义改写，与原 query 一起送检索（RRF 合并）
# 可选值：true / false；失败时静默降级为只用原 query
RAG_QUERY_REWRITE_ENABLED=false

# 单次最多生成几条改写（不含原 query），取值 1~5；上调会增加 LLM token 与延迟
RAG_REWRITE_MAX_QUERIES=3

# query 字符数 < 该值时跳过 multi-query / HyDE 改写（短/精确 query 改写收益低且费时）；0 表示不跳过
RAG_REWRITE_MIN_QUERY_LEN=6

# HyDE：让 LLM 先产出"假设性答案"再做 embedding 检索，适合口语→文档术语场景
# 可选值：true / false；每轮额外多 1 次 LLM 调用，默认关
RAG_HYDE_ENABLED=true

# 跨语言翻译轴：探测 query 语种（zh/en）后追加翻译版查询
# 解决"中文问 3GPP 术语，英文文档 dense 命中差"的双库失衡；每次额外 1 次 LLM 调用
# 可选值：true / false
RAG_TRANSLATE_QUERY_ENABLED=true


########################################
# 2.3.Hybrid Retrieval（召回数 / 阈值 / RRF 融合）
########################################
# 单次检索最终返回给 LLM 的 chunk 数；枚举/对比类问题建议 8~10
RAG_TOP_K=8

# —— Dense 阈值过滤（cosine 相似度过滤；BM25 命中豁免）——
# 全局兜底阈值（cosine 相似度 ∈ [0,1]）；0 或负数 = 禁用过滤
# 找不到对应 per-model 阈值时回退到本值
RAG_DENSE_MIN_SCORE=0.30

# —— 按模型校准的 dense 阈值（优先级高于全局值）——
# 各模型相似度分布差异明显，必须分开标定，否则双库联合命中率会被拉低：
#   MiniLM(en)    同主题对 ~0.40-0.60，建议 0.25
#   bge-small-zh  同主题对 ~0.55-0.85，建议 0.40
#   bge-m3        同主题对 ~0.45-0.75，建议 0.35
RAG_DENSE_MIN_SCORE_EN=0.25
RAG_DENSE_MIN_SCORE_ZH=0.40
RAG_DENSE_MIN_SCORE_M3=0.35

# RRF 融合常数 k；论文推荐 60，越大越平滑（rank 差异被压制），越小越极端
RRF_K=60


########################################
# 2.4.Cross-Encoder reranker（二阶段精排 + per-source 去重）
########################################
# 是否启用二阶段精排（可选值：true / false）
RERANKER_ENABLED=true

# 精排模型（可选值）：
#   BAAI/bge-reranker-base                  ★ 中英双语，~1.1GB，中文场景首选（默认）
#   BAAI/bge-reranker-v2-m3                 更准更大，多语种最佳
#   cross-encoder/ms-marco-MiniLM-L-6-v2    ~23MB，英文偏好；输出 raw logit 而非概率
RERANKER_MODEL=BAAI/bge-reranker-base

# 召回窗口倍数：精排前取 top_k × N 条候选进入 reranker；调大召回更全但精排更慢
RERANKER_RECALL_MULTIPLIER=2

# 精排后最低分阈值（不同 reranker 输出尺度不同，切换模型必须同步调整！）：
#   bge-reranker 系列：输出 sigmoid 概率 ∈ [0,1]，建议 0.30~0.50
#   ms-marco MiniLM ：输出 raw logit  ∈ [-10,10]，建议 -3 ~ 0
RAG_RERANK_MIN_SCORE=0.30

# 同一来源文件最多保留几条 chunk，避免一个长文档霸屏；<=0 表示不去重
# 注：去重发生在 reranker 之后，保证"被去重的是真低质重复"而非提前限流
RAG_K_PER_SOURCE=3


########################################
# 3.1.Agent · LLM（Provider 抽象 / API Keys / Extended Thinking）
########################################
# 当前激活的模型（model id，厂商从模型反推）。可选值见 src/config.py MODEL_CONFIGS：
#   kimi-k2.5 / kimi-k2.6 / qwen3.5-flash / glm-4-flash / deepseek-chat /
#   MiniMax-Text-01 / gpt-4o / grok-3-latest / claude-sonnet-4-5 / qwen2.5:7b（ollama 本地）
LLM_MODEL=qwen3.5-flash

# LLM HTTP 代理，仅对国外服务（openai / grok / claude / gemini）生效；国内 provider 直连不读此值
# 留空则不走代理（电脑已有 VPN 时留空即可）；需走代理时填 http://host:port
LLM_PROXY=

# Claude 单次响应最大 output token 数（仅 claude-sonnet-4-5 等 anthropic 模型生效）
CLAUDE_MAX_TOKENS=4096

# —— 各 Provider 的 API Key（用哪个填哪个；ollama 走本地无需 Key）——
# OpenAI（ChatGPT 系列）
OPENAI_API_KEY=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

# Anthropic（Claude 系列）
ANTHROPIC_API_KEY=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

# Grok / xAI（GROK_API_KEY1 为当前激活值，KEY2 为备用 / 配额轮换占位）
GROK_API_KEY1=xai-wfcLYBp9PJFi30yodRGpB2IplphBsiqIohZcuKWH4QdjBmtvMwbXdHc4oNnxHJ87fEeAYap0v4zDjXwU
GROK_API_KEY2=xai-KWtDMwM4oeMIWaSbERjkJFmEDcmJRr9fqzDtEPaIYIY50eMi7XLFYYcmCXi9yIhEB3uZhURvOWLcTOsA

# Google Gemini
GEMINI_API_KEY=

# Kimi / Moonshot
MOONSHOT_API_KEY=sk-AXKkT1CGyxmQ4hqSBoCvz13uuhtRDG2tm9aPLkZzyEKLKsB4

# DeepSeek
DEEPSEEK_API_KEY=sk-26c77364760b43a489e8798e134b86de

# Qwen / 阿里通义千问
QWEN_API_KEY=sk-dbc621b522b3434fa21752530b08fc66

# MiniMax
MINIMAX_API_KEY=sk-api-jkzLAm3t-WUEEdTMzTa7dx5TWydYRgK2YvM7Qxl2Nk2Gy1sINnoNU4v7ZZ_SMJ7w4WTo6-TbD9swZqutkUP3bvhfjz8d3MWriFGF5pwLzSyw1MBOeHsluxU

# GLM / 智谱 AI
GLM_API_KEY=725b5dc38848490e9ccc8b34b1e5abc3.TrRoWWahTAt89qup

# —— Extended Thinking（claude/qwen/kimi/deepseek/glm/minimax 支持，其余 provider 静默降级）——
# 是否启用 Extended Thinking（可选值：true / false）
THINKING_ENABLED=false

# 思考预算（tokens）；推荐：简单推理 1024~3000，复杂分析 8000~16000，AI Agent 32000+
# 注意：仅 claude 与 qwen 真正消费此值，其余 reasoning provider 不支持设 budget，忽略
THINKING_BUDGET=8000

# 单次问答调用工具最大次数
MAX_TOOL_ROUNDS=8
# 单次问答的总推理次数
MAX_TOTAL_ROUNDS=12
# plan模式下自适应放大后的最大推理次数
MAX_HARD_CAP_ROUNDS=50


########################################
# 3.2.Agent · Session（对话历史持久化）
########################################
# 对话历史 SQLite 文件路径（每个 session 一份消息流水）
MEMORY_DB_PATH=./sqlite_db/chat_history.db


########################################
# 3.2.1.多用户 / 认证
########################################
# 是否启用多用户认证（可选值：true / false）；false 时不校验登录，全部走 DEFAULT_USER_ID
AUTH_ENABLED=true
# 账号 / 登录态 / 每用户 rules 的 SQLite 路径
AUTH_DB_PATH=./sqlite_db/auth.db
# 该用户名注册后自动成为 admin（仅 admin 能改 skills / MCP / 系统配置）
AUTH_ADMIN_USERNAME=admin
# 登录态有效天数
AUTH_SESSION_TTL_DAYS=30
# 存放 session token 的 cookie 名
AUTH_COOKIE_NAME=agenta_session
# CLI / 测试 / 关认证时使用的用户 id
DEFAULT_USER_ID=1
# 同时在跑的 agent.run 并发上限（超出排队），防止打满 LLM 配额 / CPU
MAX_CONCURRENT_AGENT_RUNS=4


########################################
# 3.3.Agent · Memory（跨 Session 用户记忆）
########################################
# 是否启用跨 session 用户记忆（可选值：true / false）
# 开启后用户偏好/事实会持久化并自动注入下次对话的 system prompt
USER_MEMORY_ENABLED=true

# 用户记忆 SQLite 文件路径（独立于对话历史 DB）
USER_MEMORY_DB_PATH=./sqlite_db/user_memory.db

# 注入 system prompt 的记忆文本最大字符数，超出部分截断（防止占用过多 context）
USER_MEMORY_MAX_CHARS=1500

# 是否每轮对话结束后自动调用 LLM 提取记忆（可选值：true / false）
# 关闭时仍可通过用户说 "记住这个" / "remember this" 即时触发提取
USER_MEMORY_AUTO_EXTRACT=false

# 自动提取触发频率：每 N 轮 user 消息才触发一次（显式触发"请记住"不受此限）
USER_MEMORY_EXTRACT_EVERY_N=5

# 用户输入短于此字符数不触发自动提取（显式触发不受此限；设为 0 禁用）
USER_MEMORY_EXTRACT_MIN_INPUT_LEN=20


########################################
# 3.4.Agent · Rules（用户偏好，每人一份，存数据库；在 Rules 页编辑）
########################################
# 是否启用用户 rules 注入（可选值：true / false）
USER_RULES_ENABLED=true


########################################
# 3.5.Agent · Skills（项目级技能 .agenta/skills/）
########################################
# Skills 禁用列表文件路径（相对项目根；JSON 数组，UI toggle off 时写入）
# 文件不存在视作"未禁用任何 skill"；启动时自动清理孤儿条目
SKILLS_DISABLED_FILE=.agenta/skills/disabled.json


########################################
# 3.Agent · Quiz 出题
########################################
# Quiz DB 文件路径
QUIZ_DB_PATH=./sqlite_db/quiz.db

# 指定 create_quiz 创建的题数（可选值 5-15）
QUIZ_DEFAULT_NUM_QUESTIONS=10

# /quiz list 返回的最多最大条数
QUIZ_HISTORY_LIST_LIMIT=20


########################################
# 3.Agent · SRS 主动复习
########################################
# SRS DB 文件路径
SRS_DB_PATH=./sqlite_db/srs.db

# /srs due 返回的最多卡片条数
SRS_DEFAULT_DUE_QUERY_LIMIT=20

# SM-2 算法首次答对后下次回炉天数（推荐 1）
SRS_FIRST_INTERVAL_DAYS=1

# SM-2 算法第二次答对后下次回炉天数（推荐 6）
SRS_SECOND_INTERVAL_DAYS=6


########################################
# 3.Agent · Harness 自检
########################################
# 是否对 grade_quiz 批改结果做 critic 自检（可选值：true / false）
HARNESS_QUIZ_ENABLED=true

# 是否对 search_knowledge 召回的每个 chunk 做相关性二分类自检（可选值：true / false）
# 开启会多 1 次 LLM 调用，默认关以降低召回延迟
HARNESS_RAG_ENABLED=false

# critic 单次 LLM 调用超时（秒），超时静默降级
HARNESS_LLM_TIMEOUT_SEC=15

# quiz 批改自检阈值（critic 评分 0-5；低于该值则该题标 harness_flagged）
HARNESS_GRADING_THRESHOLD=3.5


########################################
# 3.Agent · Tools（外部工具 API Key）
########################################
# Serper.dev API Key（web_search 工具用，Google/Bing 搜索）；不配置则 web_search 工具不可用
SERPAPI_API_KEY=adbce2ab94d457f02d2a1ac8b3124260c66a8fd7


########################################
# 5.IMP · 实现方式选择
########################################
# Agent 内核（可选值，3 选 1）：
#   PYTHON    手写 ReAct 循环（默认，最稳，支持 Extended Thinking）
#   LANGCHAIN LangChain create_agent 驱动（便于接 LangSmith 追踪）
#   AUTOGPT   Plan-Execute 双循环（先规划子任务，再迷你 ReAct 逐个执行）
IMP_METHOD=PYTHON


########################################
# 5.IMP · LangChain（LangSmith 追踪，可选；仅 IMP_METHOD=LANGCHAIN 时收益最大）
########################################
# LangSmith API Key（项目代码不读，由 LangChain 框架自动消费）
LANGCHAIN_API_KEY=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

# 是否开启 LangChain 链路追踪（可选值：true / false）
LANGCHAIN_TRACING_V2=true

# LangSmith 服务端点（默认值即可，自部署时改成你的实例 URL）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LangSmith 项目名称；省略则使用 LangSmith 默认项目
LANGCHAIN_PROJECT=langchain_test


########################################
# 5.IMP · AutoGPT（仅 IMP_METHOD=AUTOGPT 时生效）
########################################
# Plan 阶段：单次规划阶段最多生成的子任务数量
AUTOGPT_MAX_PLAN_TASKS=6
# Execute 阶段：每个子任务的迷你 ReAct 子循环最多调用几轮工具
AUTOGPT_MAX_TASK_TOOL_ROUNDS=4


########################################
# 8.CLI 日志（级别 + 落盘）
########################################
# logger 输出级别（可选值：DEBUG / INFO / WARNING / ERROR / CRITICAL）
# 同时应用于终端 stderr 输出与日志文件；非法值降级 INFO 并 warn
LOG_LEVEL=INFO

# CLI 终端输出落盘模式（可选值：NONE / SINGLE / MULTI）
# NONE   不写文件
# SINGLE 固定 ./logs/agenta.log，跨启动追加（append）
# MULTI  每次启动新建 ./logs/agenta-YYYYMMDD-HHMMSS.log（write 覆盖）
CLI_LOG_MODE=SINGLE

# 单个日志文件大小上限（字节），超过即滚动；默认 5MB（5242880）。0=不限大小
# 同时作用于 CLI 的 agenta.log 与 UI 的 uvicorn.log
LOG_MAX_BYTES=5242880

# 滚动 / 归档保留的备份份数（不含当前文件）；默认 3
LOG_BACKUP_COUNT=3


########################################
# 9.防 prompt injection
########################################
# tool 名单门工作模式（normal / strict）
SECURITY_MODE=normal

# tool 黑名单（仅 normal 模式生效，逗号分隔）
TOOL_BLOCKLIST=

# tool 白名单（仅 strict 模式生效，逗号分隔）
TOOL_ALLOWLIST=

# 是否启用 plan-execute 用户审批 mode（true / false）
PLAN_PERMISSION_MODE=true


########################################
# 10.MCP（Model Context Protocol）接入（Phase 3.3）
########################################
# 是否启用 MCP 接入（true / false）
MCP_ENABLED=true

# MCP server 配置文件路径（相对项目根目录；不存在静默跳过）
MCP_CONFIG_FILE=.agenta/mcp/config.json

# MCP server 禁用列表文件路径（JSON 数组；UI toggle off 时写入；不存在视作未禁用）
MCP_DISABLED_FILE=.agenta/mcp/disabled.json

# server 启动 + initialize 握手单步超时（秒）
MCP_CONNECT_TIMEOUT_SEC=10

# 单次 tools/call 调用超时（秒）
MCP_CALL_TIMEOUT_SEC=30
