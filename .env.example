########################################
# HuggingFace 镜像（解决国内访问 huggingface.co 被墙问题）
########################################
HF_ENDPOINT=https://hf-mirror.com
# 第一次运行时设置为0， 模型缓存到本地后设为 1，禁止联网检查，加快启动速度
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# 消除 tokenizer FutureWarning
TOKENIZERS_PARALLELISM=false


########################################
# LLM HTTP 代理（仅对国外服务生效：openai / grok / claude；国内直连不需要）
########################################
LLM_PROXY=http://IP：PORT


########################################
# LLM Provider 选择
########################################
# 国内直连：kimi / qwen / glm / deepseek / minimax / ollama
# 国外需代理：openai / grok / claude
LLM_PROVIDER=qwen


########################################
# LLM API Keys
########################################
# OpenAI
OPENAI_API_KEY=sk-<YOUR_OPENAI_API_KEY>

# Anthropic
ANTHROPIC_API_KEY=sk-<YOUR_ANTHROPIC_API_KEY>
# Claude 单次响应最大 output token 数（仅 LLM_PROVIDER=claude 时生效）
CLAUDE_MAX_TOKENS=4096

# Grok/xAI
# Grok API Key 1
GROK_API_KEY1=xai-<YOUR_GROK_API_KEY1>
# Grok API Key 2
GROK_API_KEY2=xai-<YOUR_GROK_API_KEY2>

# Kimi
MOONSHOT_API_KEY=sk-<YOUR_MOONSHOT_API_KEY>

# DeepSeek
DEEPSEEK_API_KEY=sk-<YOUR_DEEPSEEK_API_KEY>

# Qwen
QWEN_API_KEY=sk-<YOUR_QWEN_API_KEY>

# MiniMax
MINIMAX_API_KEY=sk-<YOUR_MINIMAX_API_KEY>

# GLM
GLM_API_KEY=sk-<YOUR_GLM_API_KEY>


########################################
# 工具/搜索 API Keys
########################################
# Serper.dev API Key（用于 web_search 工具，申请地址：https://serper.dev）
# 注：变量名沿用 SERPAPI_API_KEY，填入 Serper.dev 控制台生成的 API Key 即可
SERPAPI_API_KEY=sk-<YOUR_SERPER_API_KEY>

########################################
# LangChain 配置
########################################
# LangChain API Key（用于 LangSmith 追踪与管理）
LANGCHAIN_API_KEY=lsv2_pt_<YOUR_LANGCHAIN_API_KEY>
# LangChain 追踪功能开关
LANGCHAIN_TRACING_V2=true
# LangChain 服务端点
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LangChain 项目名称（可选）
LANGCHAIN_PROJECT=<YOUR_LANGCHAIN_PROJECT>  # 如果没有指定，则使用默认设置


########################################
# Embedding 模型配置
########################################
# 默认 ingest 用的模型别名（CLI 不传 -m 时用它）：
#   en  → sentence-transformers/all-MiniLM-L6-v2  英文/多语言，384 维，~90MB
#   zh  → BAAI/bge-small-zh                       中文优化，512 维，~96MB
#   m3  → BAAI/bge-m3                             多语言（dense），1024 维，~568MB（首次需下载）
EMBEDDING_MODEL=en

# 检索时实际启用的 collection 列表（Iter-5）。控制 retriever 遍历哪些库，不影响 ingest。
# 与 EMBEDDING_MODELS 表里的别名一一对应，逗号分隔。常用组合：
#   en,zh   双语种双库（默认；中英文资料分别用 en/zh 模型 ingest）
#   m3      bge-m3 单库（需先 ingest --model m3）
#   en      仅英文库（消融实验：看英文文档命中是否被中文库稀释）
RAG_ACTIVE_EMBEDDINGS=en,zh

########################################
# RAG 召回配置
########################################
CHROMA_DB_PATH=./chroma_db
DOCS_DIR=./docs

# 单次检索返回的最终 chunk 数（送给 LLM 的上下文片段数）；枚举/对比类问题建议 8~10
RAG_TOP_K=8
# 同一来源文件最多保留几条 chunk，避免一个长文档霸屏；<=0 表示不去重
RAG_K_PER_SOURCE=3

# 文本分块超参（一般无需调整）
CHUNK_SIZE=600
CHUNK_OVERLAP=100

########################################
# Dense 召回阈值（Iter-2 / Iter-5）
########################################
# 全局兜底阈值（cosine 相似度，[0,1]，0 或负数表示禁用过滤）
RAG_DENSE_MIN_SCORE=0.30

# 按模型校准的 dense 阈值（优先级高于全局值）。各模型分布差异明显：
#   MiniLM(en)    同主题 ~0.40-0.60，建议 0.25
#   bge-small-zh  同主题 ~0.55-0.85，建议 0.40
#   bge-m3        同主题 ~0.45-0.75，建议 0.35
RAG_DENSE_MIN_SCORE_EN=0.25
RAG_DENSE_MIN_SCORE_ZH=0.40
RAG_DENSE_MIN_SCORE_M3=0.35

########################################
# Reranker 配置（Cross-Encoder 二阶段精排，Iter-4 默认改为 bge-reranker）
########################################
RERANKER_ENABLED=true
# 可选模型：
#   BAAI/bge-reranker-base                  ★ 中英双语，~1.1GB，中文场景首选
#   BAAI/bge-reranker-v2-m3                  更准更大，多语种最佳
#   cross-encoder/ms-marco-MiniLM-L-6-v2    ~23MB，英文偏好；输出 raw logit 不是概率
RERANKER_MODEL=BAAI/bge-reranker-base
# 召回窗口倍数：精排前取 top_k × N 条候选
RERANKER_RECALL_MULTIPLIER=3
# 精排后最低分阈值（不同 reranker 输出尺度不同！切换模型必须同步调整）：
#   bge-reranker 系列输出 sigmoid 概率 [0,1]，建议 0.30~0.50
#   ms-marco MiniLM 输出 raw logit [-10,10]，建议 -3 ~ 0
RAG_RERANK_MIN_SCORE=0.0

########################################
# BM25 + RRF 混合检索（Iter-2）
########################################
# 开启后 dense 与 BM25 同时召回，用 Reciprocal Rank Fusion 融合排名；
# 对专有名词/缩写/版本号等"低 embedding 区分度"的查询命中显著优于纯 dense
BM25_ENABLED=true
# Okapi BM25 经典超参：k1 控制 term frequency 饱和度（1.2~2.0），b 控制长度归一化（0~1）
BM25_K1=1.5
BM25_B=0.75
# RRF 融合常数 k，论文推荐 60；越大越平滑，越小越极端
RRF_K=60
# BM25 索引存储目录；为空则与 CHROMA_DB_PATH 同级
BM25_INDEX_DIR=

########################################
# Query 改写 / Multi-Query / HyDE / 翻译轴（Iter-3 + Iter-5）
########################################
# 多轮改写：让 LLM 生成 N 条同义改写，与原 query 一起送检索（RRF 自然合并）
RAG_QUERY_REWRITE_ENABLED=true
# 单次最多生成几条改写（不含原 query），1~5；上调会增加 LLM token 与延迟
RAG_REWRITE_MAX_QUERIES=3
# HyDE：让 LLM 先产出"假设性答案"作为 embedding 检索 query；适合口语→文档术语场景
# 每轮多 1 次 LLM 调用，默认关
RAG_HYDE_ENABLED=false
# 跨语言翻译轴（Iter-5）：探测 query 语种（zh/en）后追加翻译版查询
# 解决"中文问 3GPP 术语，英文文档 dense 命中差"的双库失衡，每次多 1 次 LLM 调用
RAG_TRANSLATE_QUERY_ENABLED=true

########################################
# PDF OCR 兜底（Iter-4）
########################################
# 当 PDF 文本层提取的"平均每页字符数"低于阈值时，自动调 rapidocr-onnxruntime OCR
# 处理扫描版/图片版 PDF；rapidocr-onnxruntime 与 pymupdf 未装时静默禁用
RAG_OCR_FALLBACK_ENABLED=true
# 每页字符数低于此值触发 OCR（纯文本 PDF 通常每页数百字，扫描版 < 30）
RAG_OCR_TRIGGER_CHARS_PER_PAGE=50
# OCR 渲染 DPI；越大越清晰但越慢，200 是质量/速度平衡点
RAG_OCR_DPI=200

########################################
# 对话历史存储路径
########################################
MEMORY_DB_PATH=./sqlite_db/chat_history.db

########################################
# Extended Thinking 配置
########################################
# 是否启用 Extended Thinking
THINKING_ENABLED=false

# Adaptive Thinking：自动根据问题复杂度估算 budget（LOW 1500 / MEDIUM 8000 / HIGH 32000）
# 仅在 THINKING_ENABLED=true 时生效
THINKING_ADAPTIVE=false

# Extended Thinking 预算，单位 tokens（默认 8000）
# 当 THINKING_ADAPTIVE=true 时，本值作为自动估算的上限（cap）
THINKING_BUDGET=8000

########################################
# 跨 session 用户记忆配置
########################################
# 是否启用跨 session 记忆功能（默认关闭，开启后每轮对话可持久化用户信息）
USER_MEMORY_ENABLED=true
# 用户记忆数据库路径（独立于对话历史 DB）
USER_MEMORY_DB_PATH=./sqlite_db/user_memory.db
# 注入 system prompt 的记忆最大字符数（超出部分截断）
USER_MEMORY_MAX_CHARS=1500
# 每轮对话结束后自动调用 LLM 提取记忆（每轮额外消耗 tokens，默认关闭）
# 关闭时仍可通过说 "记住这个" / "remember this" 触发即时提取
USER_MEMORY_AUTO_EXTRACT=false

########################################
# Agent 实现方式选择
########################################
# PYTHON   - 手写 ReAct 循环（默认，稳定，支持 Extended Thinking）
# LANGCHAIN - LangChain create_agent 驱动（实验性）
# AUTOGPT   - Plan→Execute→Review 三阶段循环（自主规划，逐任务执行）
IMP_METHOD=PYTHON

########################################
# Auto-GPT 专项配置（IMP_METHOD=AUTOGPT 时生效）
########################################
# 单次规划阶段最多生成的子任务数量（Plan 阶段，默认 6）
AUTOGPT_MAX_PLAN_TASKS=6
# 每个子任务迷你 ReAct 子循环最多调用几轮工具（Execute 阶段，默认 4）
AUTOGPT_MAX_TASK_TOOL_ROUNDS=4
